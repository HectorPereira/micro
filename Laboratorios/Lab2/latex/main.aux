\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Esquema de conexión del sensor LDR en un divisor resistivo cuya salida se dirige al canal ADC del microcontrolador ATmega328P. Fuente: \url  {https://paraarduino.com/sensores/fotorresistencias/valor-maximo-de-una-fotorresistencia/}.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:ldr_circuito}{{1}{2}{Esquema de conexión del sensor LDR en un divisor resistivo cuya salida se dirige al canal ADC del microcontrolador ATmega328P. Fuente: \url {https://paraarduino.com/sensores/fotorresistencias/valor-maximo-de-una-fotorresistencia/}}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Representación tridimensional del modelo de color RGB, donde cada eje corresponde a una de las componentes primarias \textit  {(Red, Green, Blue)} y su combinación genera el espacio de colores aditivos. Fuente: \url  {https://www.researchgate.net/figure/a-RGB-Color-Space-7-b-YCbCr-Color-Space-8_fig1_298734907}.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:rgb_model}{{2}{2}{Representación tridimensional del modelo de color RGB, donde cada eje corresponde a una de las componentes primarias \textit {(Red, Green, Blue)} y su combinación genera el espacio de colores aditivos. Fuente: \url {https://www.researchgate.net/figure/a-RGB-Color-Space-7-b-YCbCr-Color-Space-8_fig1_298734907}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Curva típica de resistencia frente a la iluminación en un sensor LDR. Se observa el comportamiento no lineal del dispositivo, cuya resistencia disminuye de forma exponencial al aumentar la intensidad luminosa. Fuente: \url  {https://www.researchgate.net/figure/Resistance-vs-illumination-curve-LDRs-are-light-dependent-devices-whose-resistance_fig3_318029856}.}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:ldr_curve}{{3}{2}{Curva típica de resistencia frente a la iluminación en un sensor LDR. Se observa el comportamiento no lineal del dispositivo, cuya resistencia disminuye de forma exponencial al aumentar la intensidad luminosa. Fuente: \url {https://www.researchgate.net/figure/Resistance-vs-illumination-curve-LDRs-are-light-dependent-devices-whose-resistance_fig3_318029856}}{figure.3}{}}
