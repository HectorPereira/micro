\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Curva típica de resistencia frente a la iluminación en un sensor LDR. Se observa el comportamiento no lineal del dispositivo, cuya resistencia disminuye de forma exponencial al aumentar la intensidad luminosa. Fuente: \url  {https://www.researchgate.net/figure/Resistance-vs-illumination-curve-LDRs-are-light-dependent-devices-whose-resistance_fig3_318029856}.}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:ldr_curve}{{3}{2}{Curva típica de resistencia frente a la iluminación en un sensor LDR. Se observa el comportamiento no lineal del dispositivo, cuya resistencia disminuye de forma exponencial al aumentar la intensidad luminosa. Fuente: \url {https://www.researchgate.net/figure/Resistance-vs-illumination-curve-LDRs-are-light-dependent-devices-whose-resistance_fig3_318029856}}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {II-B}}Señales PWM y control de servomotores}{2}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Señal PWM utilizada para el control de un servomotor de tipo \textit  {hobby}. La variación del ancho de pulso dentro de un periodo fijo de \SI {20}{\milli \second } determina la posición angular del eje, donde pulsos de aproximadamente \SI {1}{\milli \second }, \SI {1.5}{\milli \second } y \SI {2}{\milli \second } corresponden a 0°, 90° y 180°, respectivamente. Fuente: \url  {https://electronics.stackexchange.com/questions/346603/driving-servo-motor-with-pwm-signal}.}}{2}{figure.4}\protected@file@percent }
\newlabel{fig:pwm_servo}{{4}{2}{Señal PWM utilizada para el control de un servomotor de tipo \textit {hobby}. La variación del ancho de pulso dentro de un periodo fijo de \SI {20}{\milli \second } determina la posición angular del eje, donde pulsos de aproximadamente \SI {1}{\milli \second }, \SI {1.5}{\milli \second } y \SI {2}{\milli \second } corresponden a 0°, 90° y 180°, respectivamente. Fuente: \url {https://electronics.stackexchange.com/questions/346603/driving-servo-motor-with-pwm-signal}}{figure.4}{}}
