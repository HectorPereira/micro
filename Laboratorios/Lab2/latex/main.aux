\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Señal PWM utilizada para el control de un servomotor de tipo \textit  {hobby}. La variación del ancho de pulso dentro de un periodo fijo de \SI {20}{\milli \second } determina la posición angular del eje, donde pulsos de aproximadamente \SI {1}{\milli \second }, \SI {1.5}{\milli \second } y \SI {2}{\milli \second } corresponden a 0°, 90° y 180°, respectivamente. Fuente: \url  {https://electronics.stackexchange.com/questions/346603/driving-servo-motor-with-pwm-signal}.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:pwm_servo}{{4}{3}{Señal PWM utilizada para el control de un servomotor de tipo \textit {hobby}. La variación del ancho de pulso dentro de un periodo fijo de \SI {20}{\milli \second } determina la posición angular del eje, donde pulsos de aproximadamente \SI {1}{\milli \second }, \SI {1.5}{\milli \second } y \SI {2}{\milli \second } corresponden a 0°, 90° y 180°, respectivamente. Fuente: \url {https://electronics.stackexchange.com/questions/346603/driving-servo-motor-with-pwm-signal}}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {II-C}}Reproducción de sonido digital}{3}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Buzzer piezoeléctrico modelo PS1240, utilizado como transductor acústico para la generación de sonido mediante señales cuadradas. Su funcionamiento se basa en la vibración mecánica del material piezoeléctrico al aplicarse una señal alternante. Fuente: \url  {https://www.pishop.us/product/piezo-buzzer-ps1240/?srsltid=AfmBOooScrJtJiyvIt6zUSB8B502aj-LKG3PUMQqgUtYcYVKXt_-yDs2}.}}{3}{figure.5}\protected@file@percent }
\newlabel{fig:buzzer_ps1240}{{5}{3}{Buzzer piezoeléctrico modelo PS1240, utilizado como transductor acústico para la generación de sonido mediante señales cuadradas. Su funcionamiento se basa en la vibración mecánica del material piezoeléctrico al aplicarse una señal alternante. Fuente: \url {https://www.pishop.us/product/piezo-buzzer-ps1240/?srsltid=AfmBOooScrJtJiyvIt6zUSB8B502aj-LKG3PUMQqgUtYcYVKXt_-yDs2}}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Onda cuadrada periódica empleada para la generación de tonos audibles en un buzzer piezoeléctrico. Se indican el periodo ($T$) y la frecuencia ($f = 1/T$), parámetros fundamentales que determinan el tono y la duración de la nota reproducida. Fuente: \url  {https://www.allelcoelec.com/blog/non-sinusoidal-waveforms-square,rectangular-and-pulsed-waveforms.html}.}}{3}{figure.6}\protected@file@percent }
\newlabel{fig:onda_cuadrada}{{6}{3}{Onda cuadrada periódica empleada para la generación de tonos audibles en un buzzer piezoeléctrico. Se indican el periodo ($T$) y la frecuencia ($f = 1/T$), parámetros fundamentales que determinan el tono y la duración de la nota reproducida. Fuente: \url {https://www.allelcoelec.com/blog/non-sinusoidal-waveforms-square,rectangular-and-pulsed-waveforms.html}}{figure.6}{}}
